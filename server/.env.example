PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Admin bağlantısı: SADECE migrate/seed betikleri kullanır (şema/DDL yetkisi gerekir).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/procesmedia

# Uygulama bağlantısı: sunucu çalışırken kullanılır, kısıtlı yetkili bir DB rolü olmalı
# (least privilege — bkz. README "Veritabanı güvenliği" bölümü).
APP_DATABASE_URL=postgres://procesmedia_app:change-this-password@localhost:5432/procesmedia

# En az 32 karakter, rastgele üretin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Proces Media <no-reply@procesmedia.com>"

SHOPIER_API_KEY=your-shopier-api-key
SHOPIER_API_SECRET=your-shopier-api-secret
SHOPIER_WEBSITE_INDEX=1

DOWNLOAD_TOKEN_TTL_MINUTES=10
